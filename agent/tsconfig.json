{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "..",
    "declaration": false,
    "resolveJsonModule": true,
    "rewriteRelativeImportExtensions": true,
    "paths": {
      "typebox": [
        "./node_modules/typebox/build/index.d.mts"
      ],
      "typebox/value": [
        "./node_modules/typebox/build/value/index.d.mts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "../shared/**/*.ts"
  ]
}
