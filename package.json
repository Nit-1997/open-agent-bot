{
  "name": "open-agent",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "web",
    "e2e",
    "cloud/*"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "lint": "npm run lint --workspaces --if-present && npm run lint:scripts && npm run lint:boundary",
    "lint:boundary": "node scripts/boundary/cloud-boundary.mjs",
    "lint:scripts": "biome check --config-path scripts/biome.json scripts",
    "format:check": "npm run format:check --workspaces --if-present && npm run format:check:scripts",
    "format:check:scripts": "biome format --config-path scripts/biome.json scripts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --test scripts/test/*.test.mjs",
    "build": "npm run build --workspaces --if-present",
    "release:dry-run": "node scripts/release/dry-run.mjs",
    "lint:workflows": "docker run --rm -v \"$PWD:/repo:ro\" -w /repo rhysd/actionlint:1.7.12@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667 -color"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "marked": "12.0.2",
    "patch-package": "8.0.1",
    "typescript": "^5",
    "yaml": "2.9.0"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "undici": "^8.12.3",
      "minimatch": "^11.0.3"
    },
    "@ag-ui/proto@1.0.3": {
      "zod": "^4.6.7"
    },
    "@ai-sdk/provider-utils": {
      "undici": "^6.29.1"
    },
    "graphql-scalars": "^2.0.1"
  }
}
