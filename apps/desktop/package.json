{
  "name": "@oab/desktop",
  "version": "0.0.0-dev",
  "description": "Open Agent for Mac: a thin Electron shell that runs the local Docker stack",
  "author": "Open Agent contributors",
  "private": true,
  "license": "MIT",
  "main": "dist/main.cjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "stage": "node scripts/stage-stack.mjs",
    "dist": "node scripts/stage-stack.mjs && node scripts/build.mjs && electron-builder --mac --publish never",
    "electron:install": "install-electron",
    "lint": "biome lint",
    "format": "biome format --write",
    "format:check": "biome format",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@electron/fuses": "2.1.3",
    "@types/node": "^22.20.5",
    "electron": "45.2.1",
    "electron-builder": "26.18.1",
    "esbuild": "0.28.2",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
