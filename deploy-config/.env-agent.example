LLM_BASE_URL=http://llm:4000/v1
LLM_API_KEY=sk-local-dev
AGENT_MODEL=chat-default
SEARXNG_URL=http://search:8080
ARTIFACTS_DIR=/data/artifacts
AGENT_SHARED_SECRET=
AGENT_MODELS=chat-sonnet-5.5=Sonnet 5.5=Best quality, about 5 cents a turn|chat-default=Qwen 3.5 (local)=Free and private; slower and weaker at cards
# Optional: official Brave Search API key (free tier at https://brave.com/search/api/), used when SearXNG returns nothing
BRAVE_SEARCH_API_KEY=
# Model capabilities: frontier (strong), small (gets router tool narrowing), codemode (may run scripts)
AGENT_MODEL_CAPS=chat-sonnet-5.5=frontier,codemode
# Jev classifier: provider/model. Default uses the OpenRouter key added in the app; set TYPESAFE_API_KEY to call TypeSafe directly
JEV_MODEL=openrouter/typesafe/jev-1.14
# Jev requests in flight across all chats (one batched call per store and item)
JEV_CONCURRENCY=64
# Feature flags (1 = on). Each turns on after its milestone check passes; see docs/superpowers/specs/2026-10-29-open-agent-v2-design.md
JEV_RERANK=0
PROMPT_V2=0
JEV_STAYS=0
JEV_MUSIC=0
TURN_BUDGET=0
SOURCES_V2=0
WORKSPACE=0
RPIV=0
