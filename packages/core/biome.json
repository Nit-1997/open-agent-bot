{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["src/**/*.ts", "!src/hosted/store/database.types.ts", "evals/**/*.ts", "test/**/*.ts"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["**/cloud", "**/cloud/**", "@oab/cloud", "@oab/cloud/**"],
                "message": "Nothing outside cloud/ may import from cloud/."
              }
            ]
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "off"
      },
      "performance": {
        "useDomNodeTextContent": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "overrides": [
    {
      "includes": ["src/**", "!src/hosted/**", "!src/server.ts", "!src/scripts/rotateCredentials.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/cloud", "**/cloud/**", "@oab/cloud", "@oab/cloud/**"],
                    "message": "Nothing outside cloud/ may import from cloud/."
                  },
                  {
                    "group": ["**/hosted/**", "@supabase/*", "jose", "@oab/core", "@oab/core/**"],
                    "message": "Core must not import hosted implementations."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/hosted/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/cloud", "**/cloud/**", "@oab/cloud", "@oab/cloud/**"],
                    "message": "Nothing outside cloud/ may import from cloud/."
                  },
                  {
                    "group": ["@oab/core/hosted", "@oab/core/hosted/**"],
                    "message": "Hosted files import other hosted files by relative path."
                  },
                  {
                    "group": ["@oab/core/scripts", "@oab/core/scripts/**"],
                    "message": "Scripts are entry points; hosted code must not import them."
                  },
                  {
                    "group": ["@oab/core/identity/local*", "@oab/core/identity/local*/**"],
                    "message": "Hosted code must not use a local identity."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
