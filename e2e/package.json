{
  "name": "e2e",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "format:check": "biome format",
    "test": "node --test --disable-warning=ExperimentalWarning support/*.test.ts scripts/local-probes.test.ts",
    "local": "playwright test -c playwright.local.config.ts --project=local --grep-invert @after-restart",
    "local:after-restart": "playwright test -c playwright.local.config.ts --project=local --grep @after-restart",
    "local:demo": "playwright test -c playwright.local.config.ts --project=local-demo"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "typescript": "^5"
  }
}
