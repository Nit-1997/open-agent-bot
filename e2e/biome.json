{
  "$schema": "../node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.mts",
      "**/*.mjs",
      "**/*.json",
      "!**/node_modules",
      "!**/.auth",
      "!**/test-results",
      "!**/playwright-report",
      "!**/.local"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "performance": {
        "useDomNodeTextContent": "off"
      }
    }
  },
  "assist": {
    "enabled": true
  }
}
