# Next.js web app: copy to .env in this folder (git-ignored). Names only; never commit values. NEXT_PUBLIC_* are build args too: rebuild after changing them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=
# The same value as AGENT_SERVICE_SECRET in ../backend/.env.
AGENT_SERVICE_SECRET=
