# Backend containers: copy to .env in this folder (git-ignored); never commit values. Compose passes each service only its own names. Only two kinds of lines ship with a value: COPILOTKIT_TELEMETRY_DISABLED (fixed) and the LIMIT_* default request limits (change them per server); every other line is a name only.
# Agent. COPILOTKIT_TELEMETRY_DISABLED is fixed to true by the image and compose (the agent refuses to start otherwise); the line is for a host-run agent.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
AGENT_SERVICE_SECRET=
CREDENTIAL_KEYS=
ACCESS_REQUEST_PEPPER=
APP_ORIGIN=
RUN_TIME_LIMIT_SECONDS=
LOG_LEVEL=
JEV_MODEL=
JEV_CONCURRENCY=
AGENT_MODEL_CAPS=
AGENT_MODELS=
LLM_API_KEY=
LLM_BASE_URL=
RENDERER_URL=
COPILOTKIT_TELEMETRY_DISABLED=true
COPILOT_CONNECTS_PER_USER=
COPILOT_CONNECT_MAX_MS=
LIMIT_RUNNING_PER_USER=1
LIMIT_REQUESTS_PER_HOUR=10
LIMIT_REQUESTS_PER_MONTH=50
LIMIT_RUNNING_SERVER=8
# Turnstile secret key. Needed only for open signups; without it open mode answers human_check_unavailable.
TURNSTILE_SECRET_KEY=
# Agent and renderer (the renderer gets nothing else): openssl rand -hex 32, different from AGENT_SERVICE_SECRET.
RENDERER_SECRET=
# Caddy on EC2 only. Not secret.
AGENT_HOST=
ACME_EMAIL=
# LiteLLM gateway (litellm profile) only; the agent never receives these.
LITELLM_MASTER_KEY=
ANTHROPIC_API_KEY=
OLLAMA_OPENAI_BASE_URL=
OLLAMA_CHAT_MODEL=
