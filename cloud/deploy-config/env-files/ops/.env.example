# Operators, scripts and tests on the owner's machine only: copy to .env in this folder (git-ignored). Names only; never commit values. No container reads this file.
# Supabase Management API and project (configure-auth.mjs, gen-types.mjs).
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# The admin_scripts secret key (admin, bootstrap-admin, cleanup-e2e, evals, e2e).
SUPABASE_ADMIN_SECRET_KEY=
# Auth providers and mail (configure-auth.mjs).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
SMTP_SENDER_EMAIL=
SITE_URL=
PROD_ORIGIN=
APP_ORIGIN=
# Evals sign in as this user (default oab-eval@example.test).
EVAL_USER_EMAIL=
# cloud/e2e: the OpenRouter key saved through the app's API during a run.
E2E_OPENROUTER_KEY=
