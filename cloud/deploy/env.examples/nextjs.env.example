# Copy to cloud/deploy/.env-nextjs. Names only; never commit values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Turnstile site key (build time: rebuild/redeploy after changing it). Needed only for open signups.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
APP_ORIGIN=
AGENT_SERVICE_SECRET=
