# Copy to cloud/deploy/.env-agent. Names only; never commit values. COPILOTKIT_TELEMETRY_DISABLED is a fixed setting, not a secret: the agent refuses to start unless it is true.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
AGENT_SERVICE_SECRET=
CREDENTIAL_KEYS=
ACCESS_REQUEST_PEPPER=
APP_ORIGIN=
RUN_TIME_LIMIT_SECONDS=
LOG_LEVEL=
JEV_MODEL=
JEV_CONCURRENCY=
AGENT_MODEL_CAPS=
AGENT_MODELS=
LLM_API_KEY=
LLM_BASE_URL=
RENDERER_SECRET=
RENDERER_URL=
COPILOTKIT_TELEMETRY_DISABLED=true
COPILOT_CONNECTS_PER_USER=
COPILOT_CONNECT_MAX_MS=
LIMIT_RUNNING_PER_USER=1
LIMIT_REQUESTS_PER_HOUR=10
LIMIT_REQUESTS_PER_MONTH=50
LIMIT_RUNNING_SERVER=8
# Turnstile secret key. Needed only for open signups; without it open mode answers human_check_unavailable.
TURNSTILE_SECRET_KEY=
