{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "../..",
    "paths": {
      "@oab/core/*": [
        "../../packages/core/src/*"
      ],
      "typebox": [
        "../../node_modules/typebox/build/index.d.mts"
      ],
      "typebox/value": [
        "../../node_modules/typebox/build/value/index.d.mts"
      ]
    }
  },
  "include": [
    "evals/**/*.ts",
    "src/**/*.ts"
  ]
}
