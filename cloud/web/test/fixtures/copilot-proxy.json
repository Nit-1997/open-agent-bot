{
  "note": "Hand-written intended behaviour of the /api/copilotkit streaming proxy (PR 2.3b). Signed in for every row; APP is the app origin.",
  "rows": [
    {
      "name": "info reaches the agent with accept and the server credentials only, query dropped",
      "request": {
        "method": "GET",
        "url": "/api/copilotkit/info?agentId=openagent&next=%2F..%2Fadmin",
        "headers": {
          "cookie": "sb-access=browser-cookie",
          "authorization": "Bearer browser-token",
          "x-agent-secret": "browser-secret",
          "x-client-ip": "6.6.6.6",
          "x-forwarded-for": "7.7.7.7",
          "x-user-id": "someone-else",
          "accept": "application/json"
        },
        "body": null
      },
      "reply": {
        "status": 200,
        "headers": {
          "content-type": "application/json",
          "set-cookie": "agent=1",
          "x-foo": "bar",
          "cache-control": "public, max-age=60"
        },
        "chunks": [
          "{\"version\":\"1.84.1\"}"
        ]
      },
      "expect": {
        "status": 200,
        "headerNames": [
          "cache-control",
          "content-type"
        ],
        "headers": {
          "content-type": "application/json",
          "cache-control": "private, no-store"
        },
        "body": "{\"version\":\"1.84.1\"}",
        "upstream": [
          {
            "method": "GET",
            "path": "/copilotkit/info",
            "headerNames": [
              "accept",
              "authorization",
              "x-agent-secret"
            ],
            "auth": true,
            "body": null
          }
        ]
      }
    },
    {
      "name": "run streams three chunks in three reads with the ping untouched and only content-type copied",
      "request": {
        "method": "POST",
        "url": "/api/copilotkit/agent/openagent/run?debug=1",
        "headers": {
          "cookie": "sb-access=browser-cookie",
          "authorization": "Bearer browser-token",
          "x-agent-secret": "browser-secret",
          "x-client-ip": "6.6.6.6",
          "x-forwarded-for": "7.7.7.7",
          "x-user-id": "someone-else",
          "origin": "APP",
          "content-type": "application/json",
          "accept": "text/event-stream"
        },
        "body": "{\"threadId\":\"22222222-2222-4222-8222-222222222222\",\"runId\":\"r1\",\"messages\":[{\"id\":\"m1\",\"role\":\"user\",\"content\":\"hi\"}],\"tools\":[],\"context\":[],\"state\":{},\"forwardedProps\":{}}"
      },
      "reply": {
        "status": 200,
        "headers": {
          "content-type": "text/event-stream",
          "set-cookie": "agent=1",
          "x-foo": "bar",
          "cache-control": "public, max-age=60"
        },
        "chunks": [
          "data: {\"type\":\"RUN_STARTED\",\"threadId\":\"22222222-2222-4222-8222-222222222222\",\"runId\":\"r1\"}\n\n",
          ": ping\n\n",
          "data: {\"type\":\"RUN_FINISHED\",\"threadId\":\"22222222-2222-4222-8222-222222222222\",\"runId\":\"r1\"}\n\n"
        ]
      },
      "expect": {
        "status": 200,
        "headerNames": [
          "cache-control",
          "content-type"
        ],
        "headers": {
          "content-type": "text/event-stream",
          "cache-control": "private, no-store"
        },
        "body": "data: {\"type\":\"RUN_STARTED\",\"threadId\":\"22222222-2222-4222-8222-222222222222\",\"runId\":\"r1\"}\n\n: ping\n\ndata: {\"type\":\"RUN_FINISHED\",\"threadId\":\"22222222-2222-4222-8222-222222222222\",\"runId\":\"r1\"}\n\n",
        "reads": 3,
        "upstream": [
          {
            "method": "POST",
            "path": "/copilotkit/agent/openagent/run",
            "headerNames": [
              "accept",
              "authorization",
              "content-type",
              "x-agent-secret"
            ],
            "auth": true,
            "body": "{\"threadId\":\"22222222-2222-4222-8222-222222222222\",\"runId\":\"r1\",\"messages\":[{\"id\":\"m1\",\"role\":\"user\",\"content\":\"hi\"}],\"tools\":[],\"context\":[],\"state\":{},\"forwardedProps\":{}}"
          }
        ]
      }
